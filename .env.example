# Salin ke .env untuk pengembangan lokal, atau isi di Vercel > Settings > Environment Variables.
# JANGAN commit berkas .env ke Git.

# --- Wajib ---
# Connection string Supabase: Connect > Transaction pooler (port 6543). Ganti [YOUR-PASSWORD].
DATABASE_URL=postgres://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Garam rahasia (min. 16 karakter). Buat: openssl rand -hex 32. Jangan diganti setelah dipakai.
REPORT_SALT=
# Email kontak di halaman Disclaimer dan Privasi
CONTACT_EMAIL=halo@domainmu.id

# --- Admin (isi salah satu atau keduanya) ---
# Token per orang: nama:token (token min. 12 karakter), pisahkan dengan koma
ADMIN_TOKENS=Rina:ganti-dengan-token-panjang-acak
ADMIN_TOKEN=

# --- Cron harian (Vercel mengirimnya otomatis sebagai Authorization: Bearer ...) ---
# Buat: openssl rand -hex 16
CRON_SECRET=

# --- Opsional ---
AUTO_HIDE_AT=3
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Hanya pengembangan lokal dengan Postgres tanpa SSL:
# DATABASE_SSL=disable
